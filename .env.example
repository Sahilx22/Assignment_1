# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="FastAPI Auth Service"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development     

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/auth_service_db
# For async support (optional):
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/auth_service_db

# =============================================================================
# JWT Configuration
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-min-32-chars-long-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Google OAuth2
# =============================================================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# =============================================================================
# Twilio (SMS Gateway)
# =============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# SendGrid (Email Gateway)
# =============================================================================
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME="FastAPI Auth Service"

# =============================================================================
# CORS
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
